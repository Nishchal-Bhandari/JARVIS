DATABASE_URL=sqlite:///./jarvis.db
CORRELATION_THRESHOLD=0.45
WINDOW_MINUTES=10
TICK_SECONDS=2
SEED=42
CORS_ORIGINS=http://localhost:3000
# Optional LLM (Copilot + report rewrite) via OpenRouter. Leave the key empty
# to run fully offline on the template / intent-matching fallback.
OPENROUTER_API_KEY=
# Default is a free model; other free options: deepseek/deepseek-r1:free,
# qwen/qwen-2.5-7b-instruct:free (free-model list changes — see openrouter.ai/models).
LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free
